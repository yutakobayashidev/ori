{
  "name": "twitter-lite",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs && oxfmt --write src/features/storage/migrations.generated.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "dev:tailscale": "vite dev --host 127.0.0.1 --port 3000",
    "generate:e2e-openapi": "orval --config orval.config.ts --fail-on-warnings && oxfmt --write e2e/generated",
    "generate-routes": "node scripts/generate-routes.mjs",
    "check:routes": "pnpm generate-routes && git diff --exit-code -- src/routeTree.gen.ts",
    "build": "vite build && node scripts/build-tools.mjs",
    "start": "HOST=127.0.0.1 node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:live": "TWITTER_LITE_LIVE=1 vitest run tests/live/relay.test.ts",
    "account:setup": "node --env-file-if-exists=.env.local --import tsx scripts/account-setup.ts",
    "format:check": "oxfmt --check .",
    "check:code": "fallow dead-code --fail-on-issues",
    "check:cycles": "fallow dead-code --circular-deps --fail-on-issues"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.27",
    "@yuta/bird": "0.10.1",
    "ai": "7.0.118",
    "better-sqlite3": "13.0.3",
    "chapplin": "1.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "motion": "^13.5.1",
    "nitro": "3.0.260610-beta",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "4.0.1",
    "sanitize-html": "2.17.7",
    "shadcn": "4.21.0",
    "streamdown": "^2.6.0",
    "tw-animate-css": "1.4.0",
    "usewebmcp": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.61.1",
    "@shadcn/helpers": "0.2.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.11",
    "fallow": "3.32.0",
    "jsdom": "29.1.1",
    "orval": "8.24.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
