# Local development settings. Docker needs no environment file; optional Compose
# overrides go in .env (see docs/docker.md), not .env.local.
TWITTER_LITE_AUTH_MODE=none
TWITTER_LITE_ORIGIN=http://localhost:3000
TWITTER_LITE_DB_PATH=/absolute/path/to/ori/.data/workspace.sqlite
# Optional X reading through an independently configured relay.
# TWITTER_RELAY_BASE_URL=http://127.0.0.1:6900
# Optional public Reddit source via the read-only rdt-gateway.
# RDT_GATEWAY_URL=https://rdt.home.yutakobayashi.com
# Optional outer Tailscale identity gate (owner login is always required).
# TWITTER_LITE_AUTH_MODE=tailscale
# TWITTER_LITE_ORIGIN=https://your-host.your-tailnet.ts.net
# TWITTER_LITE_ALLOWED_LOGIN=your-tailscale-login
# Required when connecting Mastodon; keep this runtime file outside Git.
# TWITTER_LITE_CREDENTIAL_KEY_FILE=/absolute/path/to/credential-key
# TWITTER_LITE_MASTODON_ORIGINS=https://mastodon.social
# Optional Beeper integration; requires a separately installed/configured CLI.
# TWITTER_LITE_BEEPER_CLI=/absolute/path/to/beeper-cli
# TWITTER_LITE_BEEPER_TARGET=your-configured-target
# Shared Elixir runtime for Board handoffs and Research.
# Start runtime/ with the same token file and a signed-in Codex CLI.
# WORKSPACE_RUNTIME_URL=http://127.0.0.1:4318
# WORKSPACE_RUNTIME_TOKEN_FILE=/absolute/path/outside/git/runtime-token
# Runtime service only:
# WORKSPACE_RUNTIME_ROOT=/absolute/path/to/runtime-state
# WORKSPACE_CODEX_PATH=/absolute/path/to/codex
# If your signed-in CLI uses a custom home, use the same path on the server.
# CODEX_HOME=/absolute/path/to/codex-home
# TWITTER_LITE_CODEX_MODEL=gpt-6-astra
# TWITTER_LITE_REPORT_ROOT=/absolute/path/to/twitter-lite/.data/research
# Internal Codex connects to the app's own HTTP MCP endpoint.
# Defaults to http://127.0.0.1:${PORT:-3000}/mcp; set for a different bind address/port.
# TWITTER_LITE_MCP_URL=http://127.0.0.1:3000/mcp

# Optional initial owner setup code (32+ characters). Otherwise generated beside DB.
# WORKSPACE_SETUP_TOKEN=

# Optional OwnTracks HTTP collector. Provision a private existing directory and
# a JSON credential file outside Git; see docs/owntracks-collector-design.md.
# WORKSPACE_OWNTRACKS_ARCHIVE_DIR=/absolute/path/to/owntracks
# WORKSPACE_OWNTRACKS_CREDENTIAL_FILE=/absolute/path/to/owntracks-credentials.json

# Optional real Jev reply evaluation through Vercel AI Gateway.
# AI_GATEWAY_API_KEY=
