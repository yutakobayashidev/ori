#!/bin/sh
if [ "$1" = mcp ]; then
  echo '[]'
  exit 0
fi
while IFS= read -r line; do
echo "$line" >> protocol.jsonl
case "$line" in
  *'"method":"initialize"'*) echo '{"id":1,"result":{}}';;
  *'"method":"thread/start"'*)
    case "$line" in
      *'"dynamicTools":['*) echo '{"id":2,"result":{"thread":{"id":"dynamic-thread"}}}';;
      *) echo '{"id":2,"error":{"message":"Missing dynamic tools"}}';;
    esac;;
  *'"method":"thread/resume"'*) echo '{"id":2,"result":{"thread":{"id":"dynamic-thread"}}}';;
  *'"method":"turn/start"'*)
    echo '{"method":"item/agentMessage/delta","params":{"delta":"Before"}}'
    echo '{"id":50,"method":"item/tool/call","params":{"callId":"call-draft","tool":"save_reply_draft","arguments":{"text":"draft"}}}'
    ;;
  *'"id":50,'*)
    echo '{"id":51,"method":"item/tool/call","params":{"callId":"call-draft","tool":"save_reply_draft","arguments":{"text":"draft"}}}'
    ;;
  *'"id":51,'*)
    echo '{"method":"item/agentMessage/delta","params":{"delta":"After"}}'
    echo '{"method":"turn/completed","params":{"turn":{"status":"completed"}}}'
    ;;
esac
done
